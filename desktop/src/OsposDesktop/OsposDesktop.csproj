<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the project compile (not run) on Linux/macOS build machines. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>OsposDesktop</RootNamespace>
    <AssemblyName>OsposDesktop</AssemblyName>
    <Product>OSPOS Desktop</Product>
    <Description>Windows desktop app for Open Source Point of Sale</Description>
    <Version>1.0.0</Version>
    <ApplicationIcon>Assets\ospos.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OsposDesktop.Core\OsposDesktop.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\ospos.ico" />
  </ItemGroup>

</Project>
