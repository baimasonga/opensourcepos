<Window x:Class="OsposDesktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource AppWindow}"
        Title="OSPOS Desktop settings"
        Icon="Assets/ospos.ico"
        Width="560" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">
    <Border Style="{StaticResource Card}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource Heading}" Text="Settings" />
            <TextBlock x:Name="IntroText" Style="{StaticResource Muted}" Margin="0,6,0,20"
                       Text="Connect this computer to the OSPOS server for your shop." />

            <Label Style="{StaticResource FieldLabel}" Content="_Server address" Target="{Binding ElementName=ServerUrlBox}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ServerUrlBox" Grid.Column="0" TextChanged="OnServerUrlChanged" />
                <Button x:Name="TestButton" Grid.Column="1" Margin="8,0,0,0" Content="Test"
                        Style="{StaticResource SecondaryButton}" Click="OnTestClick" />
            </Grid>
            <TextBlock x:Name="ServerUrlHint" Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                       Text="For example 192.168.1.10, pos.local:8080 or https://shop.example.com/pos" />

            <TextBlock Style="{StaticResource Heading}" FontSize="15" Margin="0,24,0,8" Text="Receipts" />
            <CheckBox x:Name="SilentPrintingBox" Content="Print receipts _without showing the print dialog"
                      Checked="OnSilentPrintingChanged" Unchecked="OnSilentPrintingChanged" />

            <StackPanel x:Name="PrinterPanel" Margin="24,8,0,0">
                <Label Style="{StaticResource FieldLabel}" Content="Receipt _printer" Target="{Binding ElementName=PrinterBox}" />
                <ComboBox x:Name="PrinterBox" />
                <Label Style="{StaticResource FieldLabel}" Content="Page _margin (mm)" Margin="0,12,0,0" Target="{Binding ElementName=MarginBox}" />
                <TextBox x:Name="MarginBox" Width="96" HorizontalAlignment="Left" />
            </StackPanel>

            <TextBlock Style="{StaticResource Heading}" FontSize="15" Margin="0,24,0,8" Text="Window" />
            <CheckBox x:Name="FullScreenBox" Content="Start in _full screen (press F11 to switch)" />
            <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                       Text="Open these settings any time with Ctrl+, (comma). F5 reloads the page." />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                       Margin="0,16,0,0" Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" IsCancel="True" />
                <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                        IsDefault="True" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
