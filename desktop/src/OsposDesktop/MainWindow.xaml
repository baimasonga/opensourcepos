<Window x:Class="OsposDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Style="{StaticResource AppWindow}"
        Title="OSPOS Desktop"
        Icon="Assets/ospos.ico"
        Width="1366" Height="800"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="WebView" DefaultBackgroundColor="#F5F6F8" />

        <!-- Shown while connecting and whenever the OSPOS server cannot be reached. -->
        <Grid x:Name="StatusOverlay" Background="{StaticResource BackgroundBrush}">
            <Border Style="{StaticResource Card}" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <Image Source="Assets/ospos.ico" Width="56" Height="56" Margin="0,0,0,16" />
                    <TextBlock x:Name="StatusHeading" Style="{StaticResource Heading}" TextAlignment="Center" Text="Connecting to OSPOS…" />
                    <TextBlock x:Name="StatusMessage" Style="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,0" />
                    <StackPanel x:Name="StatusActions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0" Visibility="Collapsed">
                        <Button Content="Try again" Style="{StaticResource PrimaryButton}" Click="OnRetryClick" />
                        <Button Content="Settings" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnSettingsClick" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
